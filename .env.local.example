# PlastfortSul CRM — variáveis de ambiente
#
# Copie para `.env.local` e preencha. O `.gitignore` cobre `.env*`, com
# exceção deste exemplo, então o arquivo real nunca é versionado.
#
# NENHUM VALOR REAL AQUI. Este arquivo vai para o repositório e para a
# imagem Docker; tudo abaixo é placeholder.
#
# O que cada variável faz, onde encontrar cada valor e o que quebra se
# faltar: docs/configuracao-env.md
#
# O token do WhatsApp NÃO fica aqui. Ele é gravado criptografado no
# banco pela tela Configurações → WhatsApp, junto com o token de
# verificação do webhook, o PIN de duas etapas e as chaves de IA.

# ============================================================
# Supabase — obrigatórias
# Painel → Project Settings → API
# ============================================================

# Project URL. Vai para o navegador; não é segredo.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave "anon / public". Também vai para o navegador. Sozinha não dá
# acesso a nada: todo acesso passa por RLS e pela sessão do usuário.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Chave "service_role" — O SEGREDO MAIS SENSÍVEL DO SISTEMA.
# Ignora RLS por completo: lê e escreve qualquer linha de qualquer
# conta. Nunca em variável NEXT_PUBLIC_*, nunca no navegador, nunca em
# log. Sem ela o webhook não grava mensagens, automações e fluxos não
# rodam, e a IA não responde.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# ============================================================
# Criptografia — obrigatória
# ============================================================

# AES-256-GCM. 32 bytes em hexadecimal = EXATAMENTE 64 caracteres.
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Trocar esta chave torna ilegível tudo que já foi criptografado com a
# anterior — o token do WhatsApp e as chaves de IA precisam ser colados
# de novo. Guarde-a onde guarda senha.
ENCRYPTION_KEY=64-caracteres-hexadecimais-aqui

# ============================================================
# Endereço da aplicação — obrigatórias
# ============================================================

# Sem barra no final. É o que monta o link do convite de equipe
# (/join/<token>). Sem ela a aplicação tenta deduzir do cabeçalho Host
# e, falhando, cai em localhost — um link que não funciona para quem
# recebeu.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# pt-BR | en | ko. O padrão do código é `en`; para este produto é
# sempre pt-BR. Trocar exige reiniciar o servidor.
NEXT_PUBLIC_APP_LOCALE=pt-BR

# ============================================================
# Meta / WhatsApp — necessárias para o WhatsApp funcionar
# developers.facebook.com → seu app → Configurações → Básico
# ============================================================

# Verifica a assinatura X-Hub-Signature-256 de cada webhook. É o que
# separa um evento legítimo de alguém forjando mensagens no endpoint.
META_APP_SECRET=sua-chave-secreta-do-aplicativo

# O upload retomável de mídia para modelos é escopado por aplicativo.
# Sem ele, enviar um modelo com cabeçalho de imagem ou documento falha.
META_APP_ID=seu-id-do-aplicativo

# ============================================================
# Automações — necessária para o agendador rodar
# ============================================================

# Protege /api/automations/cron e /api/flows/cron. O agendador envia no
# cabeçalho `x-cron-secret`; a comparação é em tempo constante.
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# O agendador precisa chamar A CADA MINUTO: é este tique que leva as
# mudanças de etapa das oportunidades ao motor (migração 065), cancela
# as esperas de quem respondeu e varre os aniversários do dia. O cron
# gratuito da Vercel só dispara uma vez por dia — não serve para isto.
#
# Sem ela a rota responde 503 — fechada por padrão, nunca aberta. E
# nenhuma automação agendada dispara.
AUTOMATION_CRON_SECRET=

# ============================================================
# Endurecimento — opcional, recomendado em produção
# ============================================================

# Hostnames separados por vírgula. Quando definida, o endereço do link
# de convite só é aceito se vier de um host da lista. Defesa em
# profundidade contra um cabeçalho Host forjado.
# ALLOWED_INVITE_HOSTS=crm.plastfortsul.com.br

# ============================================================
# Só em desenvolvimento
# ============================================================

# Origens extras aceitas pelo servidor de dev do Next, para abrir o app
# de outro aparelho na mesma rede. Formato ip:porta, separadas por
# vírgula. Sem efeito em produção.
# ALLOWED_DEV_ORIGINS=192.168.1.50:3000

# Com `true`, enviar um modelo para aprovação pula a chamada de rede e
# finge sucesso. Serve para exercitar o fluxo sem sujar a fila de
# revisão da Meta. NUNCA em produção.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ============================================================
# Ajuste fino da IA — opcional
# ============================================================

# Tempo limite por chamada ao provedor. Padrão 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# Quantas mensagens recentes vão como contexto. Padrão 20.
# AI_CONTEXT_MESSAGE_LIMIT=20

# Modelo usado para transcrever áudio recebido (migração 049). Padrão
# `whisper-1`, e o padrão é conservador de propósito: isto roda na chave
# que a conta trouxe, no tier que a conta tem, e o modo de falha que vale
# evitar é "seus áudios pararam porque escolhemos um modelo que a sua
# conta não chama". Só o endpoint de transcrição da OpenAI lê esta
# variável — a descrição de imagens usa o modelo já configurado em
# Configurações › IA.
# AI_TRANSCRIBE_MODEL=whisper-1

# ============================================================
# Docker
# ============================================================

# Porta publicada no host por docker-compose. Dentro do container o
# servidor sempre escuta na 3000.
# HOST_PORT=3000
